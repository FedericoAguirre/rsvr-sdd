# PostgreSQL credentials — override for production
# Local dev password is "rsvr" to match DATABASE_URL below.
# For production, set a strong password here AND update DATABASE_URL password.
POSTGRES_DB=rsvr
POSTGRES_USER=rsvr
POSTGRES_PASSWORD=rsvr

# Django settings
DEBUG=True
SECRET_KEY=generate-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,.example.com

# Local development database connection
DATABASE_URL=postgres://rsvr:rsvr@localhost:5432/rsvr
